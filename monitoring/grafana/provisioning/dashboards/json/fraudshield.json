{
  "uid": "fraudshield-overview",
  "title": "FraudShield \u2014 Service Monitoring",
  "tags": [
    "fraudshield",
    "local"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "editable": false,
  "panels": [
    {
      "id": 1,
      "title": "API scrape health: 1 = UP, 0 = DOWN",
      "description": "Whether Prometheus can scrape the API metrics endpoint.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"fraudshield-api\"}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D55E00",
                "value": null
              },
              {
                "color": "#0072B2",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#D55E00",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "#0072B2",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "title": "Predicted fraud percentage \u2014 last 5 minutes",
      "description": "Flagged /predict decisions divided by all /predict decisions. Explanations are excluded. This is not confirmed fraud prevalence. No value when there are no recent decisions.",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 16,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(fraudshield_decisions_total{job=\"fraudshield-api\",endpoint=\"/predict\",decision=\"flagged\"}[5m])) / sum(rate(fraudshield_decisions_total{job=\"fraudshield-api\",endpoint=\"/predict\"}[5m]))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Request rate by endpoint",
      "description": "POST requests per second, averaged over 5 minutes. Includes successful and failed requests.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(fraudshield_requests_total{job=\"fraudshield-api\"}[5m]))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "axisLabel": "Requests per second"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/predict"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/explain"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 4,
      "title": "Estimated p95 server latency by endpoint",
      "description": "Histogram estimate over 5 minutes, including all response statuses. Excludes client/network time. No value without recent requests. The 50 ms objective must also be checked with client-side benchmarks.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le, endpoint) (rate(fraudshield_request_duration_seconds_bucket{job=\"fraudshield-api\"}[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "axisLabel": "Latency (milliseconds)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/predict"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/explain"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "title": "HTTP error rate by endpoint",
      "description": "4xx and 5xx responses per second over 5 minutes. Invalid input responses count as errors here, but do not count as model decisions.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (endpoint) (rate(fraudshield_requests_total{job=\"fraudshield-api\",status=~\"4..|5..\"}[5m])) or on (endpoint) (0 * sum by (endpoint) (rate(fraudshield_requests_total{job=\"fraudshield-api\"}[5m])))",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "axisLabel": "Failed requests per second (HTTP 4xx and 5xx)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "/predict"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "/explain"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Input drift vs. training reference",
      "description": "Compares bucket proportions for the last 500 successful predictions with training data. Scores appear after 100 samples. The window holds its last value while traffic is idle. The 0.20 line is a demo threshold, not a model accuracy measurement.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraudshield_input_drift_score",
          "legendFormat": "{{feature}}"
        },
        {
          "refId": "B",
          "expr": "0 * max(fraudshield_input_drift_score) + 0.20",
          "legendFormat": "Demo threshold"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "none",
          "custom": {
            "axisLabel": "Drift score (0 to 1)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "type"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "amount"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "oldbalanceOrg"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#009E73"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Demo threshold"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#000000"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 7,
      "title": "Gateway: scrape health",
      "description": "1 means Prometheus can scrape the gateway. This does not verify upstream model readiness.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"fraudshield-gateway\"}",
          "instant": true,
          "legendFormat": "health",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D55E00",
                "value": null
              },
              {
                "color": "#0072B2",
                "value": 1
              }
            ]
          },
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "#D55E00",
                  "index": 0
                },
                "1": {
                  "text": "UP",
                  "color": "#0072B2",
                  "index": 1
                }
              }
            }
          ],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 8,
      "title": "Gateway: challenger weight",
      "description": "Configured challenger traffic percentage. Actual proportions depend on transaction IDs and sample size.",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraudshield_gateway_canary_weight_percent{job=\"fraudshield-gateway\"}",
          "instant": true,
          "legendFormat": "weight",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "unit": "percent",
          "mappings": [],
          "max": 100,
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 9,
      "title": "Gateway: fallback attempts since restart",
      "description": "Challenger failures that initiated champion fallback, including attempts where champion also failed. Resets with the gateway process.",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraudshield_gateway_fallback_attempts_total{job=\"fraudshield-gateway\"}",
          "instant": true,
          "legendFormat": "fallbacks",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 10,
      "title": "Gateway: automatic removals since restart",
      "description": "Automatic changes that set challenger traffic to zero. This does not revert model artifacts. Resets with the gateway process.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 29,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "fraudshield_gateway_automatic_removals_total{job=\"fraudshield-gateway\"}",
          "instant": true,
          "legendFormat": "removals",
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "unit": "short",
          "mappings": [],
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 11,
      "title": "Gateway: prediction request rate by HTTP status",
      "description": "POST /predict requests per second, including invalid inputs and scoring failures. Sparse traffic may leave some status series absent.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(fraudshield_gateway_requests_total{job=\"fraudshield-gateway\"}[5m]))",
          "legendFormat": "{{status}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "custom": {
            "axisLabel": "Requests per second"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "200"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "422"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "500"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#D55E00"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "503"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#CC79A7"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 12,
      "title": "Gateway: estimated p95 prediction latency",
      "description": "Histogram estimate over five minutes, including upstream HTTP and fallback. Includes all POST prediction outcomes. No requests means no latency estimate.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 34,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fraudshield_gateway_request_duration_seconds_bucket{job=\"fraudshield-gateway\"}[5m])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#0072B2",
                "value": null
              }
            ]
          },
          "custom": {
            "axisLabel": "Latency (seconds)"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    }
  ]
}
