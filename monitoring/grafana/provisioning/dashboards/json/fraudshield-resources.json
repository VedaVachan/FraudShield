{
  "uid": "fraudshield-resources",
  "title": "FraudShield \u2014 VM and Container Resources",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "tags": [
    "fraudshield",
    "resources"
  ],
  "panels": [
    {
      "id": 1,
      "title": "VM CPU busy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisLabel": "CPU busy (%)"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"fraudshield-node\",mode=\"idle\"}[5m])))",
          "legendFormat": "VM"
        }
      ],
      "description": "Share of CPU time the VM was busy over the last 5 minutes: 100 minus the idle share, averaged over all CPUs (Node Exporter).",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 2,
      "title": "VM memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisLabel": "Memory used (%)"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"fraudshield-node\"} / node_memory_MemTotal_bytes{job=\"fraudshield-node\"})",
          "legendFormat": "VM"
        }
      ],
      "description": "Percentage of VM memory not available to programs: 100 x (1 - MemAvailable / MemTotal) (Node Exporter).",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "title": "VM root filesystem used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "axisLabel": "Filesystem used (%)"
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "#0072B2"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"fraudshield-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{job=\"fraudshield-node\",mountpoint=\"/\",fstype!~\"tmpfs|overlay\"})",
          "legendFormat": "Root filesystem"
        }
      ],
      "description": "Percentage of the root filesystem (/) in use, excluding tmpfs and overlay filesystems (Node Exporter).",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 4,
      "title": "Exporter scrape health",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "Scrape up (1) or down (0)"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "fraudshield-node"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#0072B2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "fraudshield-containers"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#E69F00"
                }
              }
            ]
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"fraudshield-node|fraudshield-containers\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "description": "Whether Prometheus can scrape the Node Exporter (VM) and cAdvisor (containers). 1 means up, 0 means down.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 5,
      "title": "Container CPU usage \u2014 cores",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "axisLabel": "CPU cores in use"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"fraudshield-containers\",name!=\"\",container_label_com_docker_compose_project=~\"fraudshield|fraudshield-canary|fraudshield-alerts|fraudshield-resources\"}[5m]))",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "CPU used by each container, in cores, averaged over 5 minutes (cAdvisor). Only the FraudShield compose projects are included.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Container memory working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "fraudshield-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "axisLabel": "Memory (bytes)"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name) (container_memory_working_set_bytes{job=\"fraudshield-containers\",name!=\"\",container_label_com_docker_compose_project=~\"fraudshield|fraudshield-canary|fraudshield-alerts|fraudshield-resources\"})",
          "legendFormat": "{{name}}"
        }
      ],
      "description": "Working-set memory of each container (cAdvisor), highest value per container name. Only the FraudShield compose projects are included.",
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    }
  ]
}
