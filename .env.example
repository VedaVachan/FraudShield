# Copy this file to .env and replace the placeholder. Never commit .env.
# Required by compose.yaml (Grafana admin password):
GRAFANA_ADMIN_PASSWORD=change-me

# Required by the optional canary and alert stacks. These are normally exported
# in the shell (see README.md), shown here only as names:
# GATEWAY_UID=<output of: id -u>
# GATEWAY_GID=<output of: id -g>
# LOCAL_UID=<output of: id -u>
# LOCAL_GID=<output of: id -g>
